{
  "manifest_version": 3,
  "name": "Skip Intro",
  "version": "0.2.0",
  "description": "Automatic intro detection with player signals and live browser fingerprints. No video downloads, no AI.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Skip Intro",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": [
        "core.js",
        "fingerprint.js",
        "analysis.js",
        "content.js"
      ]
    }
  ]
}
